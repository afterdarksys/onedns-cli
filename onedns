# Auth
# =============================================================================

def cmd_login(args):
    """Save an API key (prompts if not provided)."""
    key = args.api_key
    if not key:
        print("Get your API key at https://onedns.io/settings/api-keys")
        key = getpass.getpass("API key: ").strip()
    if not key:
        die("API key cannot be empty")
    try:
        api("GET", "/zones", api_key=key)
    except SystemExit:
        die("Invalid API key")
    save_config(key)
    ok("Logged in. API key saved.")


def cmd_logout(args):
    clear_config()
    ok("Logged out.")


def cmd_whoami(args):
    data = api("GET", "/settings/api-keys")
    keys = data.get("api_keys", data.get("keys", []))
    if keys:
        ok(f"Authenticated via API key ({len(keys)} key(s) on account)")
    else:
        ok("Authenticated")


