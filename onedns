def cmd_firewall_rules_list(args):
    """List per-zone DNS firewall rules (stored in platform, synced to dnsscienced)."""
    zone_id = find_zone_id(args.zone)
    data = api("GET", f"/zones/{zone_id}/dns-firewall/rules")
    rules = data.get("rules", [])
    if not rules:
        ok("No DNS firewall rules.")
        return
    rows = [
        (r.get("id"), r.get("priority", ""), r.get("action"), r.get("domain_suffix", ""),
         r.get("client_cidr", ""), r.get("query_type", ""), r.get("enabled", True))
        for r in rules
    ]
    print_table(rows, ["ID", "PRI", "ACTION", "DOMAIN", "CIDR", "TYPE", "ENABLED"])


