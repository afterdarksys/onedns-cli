    if args.domain:
        rule["domain_suffix"] = args.domain
    if args.cidr:
        rule["client_cidr"] = args.cidr
    if args.type:
        rule["query_type"] = args.type.upper()
    if args.name:
        rule["name"] = args.name
    if args.priority:
        rule["priority"] = args.priority
    data = api("POST", f"/zones/{zone_id}/dns-firewall/rules", json=rule)
    rule_obj = data.get("rule", data)
    ok(f"Created firewall rule {rule_obj.get('id')}: {rule_obj.get('action')} (priority {rule_obj.get('priority')})")


