# =============================================================================
# Parser
# =============================================================================

def build_parser():
    parser = argparse.ArgumentParser(
        prog="onedns",
        description="OneDNS CLI — Enterprise DNS management",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Docs: https://onedns.io/cli\nAPI keys: https://onedns.io/settings/api-keys"
    )
    parser.add_argument("--version", action="version", version=f"onedns {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True, metavar="<command>")

    # ── login / logout / whoami ───────────────────────────────────────────────
    p = sub.add_parser("login", help="Authenticate with an API key")
    p.add_argument("--api-key", dest="api_key", help="API key (will prompt if omitted)")
    p.set_defaults(func=cmd_login)

    p = sub.add_parser("logout", help="Remove saved credentials")
    p.set_defaults(func=cmd_logout)

    p = sub.add_parser("whoami", help="Show current authentication status")
    p.set_defaults(func=cmd_whoami)

    # ── configure (legacy alias for login) ───────────────────────────────────
    p = sub.add_parser("configure", help="Set API key (alias for login)")
    p.add_argument("--api-key", dest="api_key", help="API key (will prompt if omitted)")
    p.set_defaults(func=cmd_login)

    # ── api-keys ──────────────────────────────────────────────────────────────
    pak = sub.add_parser("api-keys", help="Manage API keys")
    aksub = pak.add_subparsers(dest="apikeys_cmd", required=True, metavar="<subcommand>")

    p = aksub.add_parser("list", help="List API keys on your account")
    p.set_defaults(func=cmd_apikeys_list)

    p = aksub.add_parser("create", help="Create a new API key")
    p.add_argument("--name", required=True, help="Key name/label")
    p.add_argument("--expires", type=int, metavar="DAYS", help="Expire after N days")
    p.set_defaults(func=cmd_apikeys_create)

    p = aksub.add_parser("revoke", help="Revoke an API key")
