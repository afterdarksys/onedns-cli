def cmd_record_create(args):
    zone_id = find_zone_id(args.zone)
    payload = {
        "type": args.type.upper(),
        "name": args.name,
        "content": args.content,
        "ttl": args.ttl,
        "proxied": args.proxied,
    }
    if args.priority is not None:
        payload["priority"] = args.priority
    r = api("POST", f"/zones/{zone_id}/records", json=payload)
    record = r.get("record", r)
    ok(f"Created record {record.get('id')}: {record.get('name')} {record.get('type')} {record.get('content')}")


def cmd_record_update(args):
    zone_id = find_zone_id(args.zone)
    payload = {}
    if args.content:
        payload["content"] = args.content
    if args.ttl:
        payload["ttl"] = args.ttl
    if args.name:
        payload["name"] = args.name
    if args.type:
        payload["type"] = args.type.upper()
    if args.proxied is not None:
        payload["proxied"] = args.proxied
    if not payload:
        die("Nothing to update — provide at least one of --content, --ttl, --name, --type")
    r = api("PUT", f"/zones/{zone_id}/records/{args.record_id}", json=payload)
    record = r.get("record", r)
    ok(f"Updated record {record.get('id')}: {record.get('name')} {record.get('type')} {record.get('content')}")


def cmd_record_delete(args):
    zone_id = find_zone_id(args.zone)
    api("DELETE", f"/zones/{zone_id}/records/{args.record_id}")
    ok(f"Deleted record {args.record_id}")


def cmd_record_set(args):
    """Upsert: update existing records matching name+type, or create."""
    zone_id = find_zone_id(args.zone)
    rtype = args.type.upper()
    data = api("GET", f"/zones/{zone_id}/records", params={"type": rtype})
    records = data.get("records", [])
    name = args.name.rstrip(".")
    matches = [
        r for r in records
        if r.get("name", "").rstrip(".") in (name, f"{name}.{args.zone.rstrip('.')}")
           or (name == "@" and r.get("name", "") in ("@", args.zone.rstrip(".")))
    ]
    if matches:
        for r in matches:
            updated = api("PUT", f"/zones/{zone_id}/records/{r['id']}", json={"content": args.content, "ttl": args.ttl})
            rec = updated.get("record", updated)
            ok(f"Updated {rec.get('name')} {rec.get('type')} → {rec.get('content')}")
    else:
        created = api("POST", f"/zones/{zone_id}/records", json={
            "type": rtype, "name": name, "content": args.content, "ttl": args.ttl, "proxied": False
        })
        rec = created.get("record", created)
        ok(f"Created {rec.get('name')} {rec.get('type')} → {rec.get('content')}")


