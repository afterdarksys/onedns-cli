#!/usr/bin/env python3
"""OneDNS CLI — Enterprise DNS management for onedns.io"""

import os
import sys
import json
import argparse
import configparser
import getpass
import tempfile
from pathlib import Path

import requests

CONFIG_PATH = Path.home() / ".config" / "onedns" / "config"
BASE_URL = os.environ.get("ONEDNS_URL", "https://onedns.io")
API_BASE = f"{BASE_URL}/api/v1"

VERSION = "2.0.0"


# ── Config ────────────────────────────────────────────────────────────────────

def _read_config():
    cfg = configparser.ConfigParser(interpolation=None)
    if CONFIG_PATH.exists():
        cfg.read(CONFIG_PATH)
    return cfg


def load_api_key():
    key = os.environ.get("ONEDNS_API_KEY")
    if key:
        return key
    cfg = _read_config()
    key = cfg.get("default", "api_key", fallback=None)
    if key:
        return key
    die("Not authenticated. Run: onedns login")


def save_config(api_key):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    cfg = configparser.ConfigParser(interpolation=None)
    cfg["default"] = {"api_key": api_key}
    # mkstemp creates a private (0600) file before any credential is written.
    # Replacing atomically also fixes permissions on existing config files.
    fd, temporary_path = tempfile.mkstemp(dir=CONFIG_PATH.parent, prefix=".config-")
    try:
        with os.fdopen(fd, "w") as f:
            cfg.write(f)
        os.replace(temporary_path, CONFIG_PATH)
    finally:
        if os.path.exists(temporary_path):
            os.unlink(temporary_path)


def clear_config():
    if CONFIG_PATH.exists():
        CONFIG_PATH.unlink()


# ── HTTP ──────────────────────────────────────────────────────────────────────

def api(method, path, api_key=None, raw=False, **kwargs):
    if api_key is None:
        api_key = load_api_key()
    url = f"{API_BASE}{path}" if not path.startswith("http") else path
    headers = {"X-API-Key": api_key}
    if "json" in kwargs:
        headers["Content-Type"] = "application/json"
    try:
        resp = requests.request(
            method, url, headers=headers, verify=True, timeout=(10, 30),
            allow_redirects=False, **kwargs
        )
    except requests.exceptions.SSLError:
        die("TLS certificate verification failed. Check the server certificate or REQUESTS_CA_BUNDLE.")
    except requests.exceptions.Timeout:
        die("API request timed out")
    except requests.exceptions.RequestException:
        die("Could not connect to the API")
    if 300 <= resp.status_code < 400:
        die("API redirect refused. Set ONEDNS_URL to the final trusted endpoint.")
    if resp.status_code == 401:
        die("Authentication failed — run: onedns login")
    if resp.status_code == 403:
        die("Access denied")
    if resp.status_code == 404:
        die(f"Not found: {path}")
    if resp.status_code >= 400:
        body = {}
        try:
            body = resp.json()
        except Exception:
            pass
        die(f"API error {resp.status_code}: {body.get('error', body.get('message', resp.text))}")
    if raw:
        return resp.text
    return resp.json() if resp.content else {}


# ── Output ────────────────────────────────────────────────────────────────────

def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def ok(msg):
    print(msg)


def print_json(data):
    print(json.dumps(data, indent=2))


def print_table(rows, headers):
    if not rows:
        return
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(str(cell)))
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    print(fmt.format(*headers))
    print("  ".join("-" * w for w in widths))
    for row in rows:
        print(fmt.format(*[str(c) for c in row]))


# ── Helpers ───────────────────────────────────────────────────────────────────

def find_zone_id(name):
    """Resolve zone name or ID → integer ID."""
    try:
        return int(name)
    except ValueError:
        pass
    data = api("GET", "/zones")
    for z in data.get("zones", []):
        if z["name"].rstrip(".") == name.rstrip("."):
            return z["id"]
    die(f"Zone not found: {name}")


def _zone_arg(p, positional=True):
    if positional:
        p.add_argument("zone", help="Zone name or ID")
    else:
        p.add_argument("--zone", required=True, help="Zone name or ID")


